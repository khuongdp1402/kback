# Base URL of the KBack backend (the Next.js app in the parent folder). Its domain must also be
# whitelisted in the Zalo Mini App console (Cấu hình → Domain được phép gọi API).
VITE_KBACK_API_URL="https://kback-app.vercel.app"

# Local dev only, when running outside the Zalo app (plain browser via `npm run dev`), where
# zmp-sdk getAccessToken() is unavailable. Requires ZALO_AUTH_MOCK=true on the backend (ignored
# in production). Format: mock:<any-id>:<display name>
VITE_ZALO_DEV_MOCK_TOKEN=""
