# Copy this file to .env and fill in real values when you have them.
# Everything works out of the box with mock providers — no credentials required to run the app.
#
# ⚠️ BEFORE switching AFFILIATE_PROVIDER or PAYOUT_PROVIDER to a real value and launching with
# real users/real money, complete the compliance checklist in README.md § "Pháp lý & tuân thủ"
# first: register as a publisher through an affiliate network (not a personal Shopee account),
# register a business household (hộ kinh doanh), and notify the e-commerce website with the
# Ministry of Industry and Trade (online.gov.vn). Running with mock providers has no legal
# exposure since no real money moves; running with real providers before those steps do carries
# real regulatory and contractual risk — see README.md for the specifics.

# --- Database ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Auth (NextAuth) ---
# Generate a real secret: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# --- Legal compliance safety guard ---
# Required (in addition to real credentials below) before real providers activate. Leave "false"
# during development. Only set to "true" after completing the checklist in README.md §
# "Pháp lý & tuân thủ" (business registration, publisher registration through an affiliate
# network, e-commerce site notification with the Ministry of Industry and Trade). While this is
# "false", the app always uses the mock providers regardless of what's set below — see
# lib/affiliate/index.ts and lib/payout/index.ts.
LEGAL_COMPLIANCE_CONFIRMED="false"

# --- Affiliate network provider ---
# "mock" simulates deep links + conversions locally, no credentials needed.
# "accesstrade" calls the real AccessTrade API — requires the key below AND
# LEGAL_COMPLIANCE_CONFIRMED=true. Each Shop also needs its accessTradeCampaignId set from
# /admin/shops (per-merchant campaign id, found on the campaign's AccessTrade page URL).
# Docs: https://developers.accesstrade.vn/
# "shopee_direct" calls Shopee's OWN affiliate API directly (affiliate.shopee.vn), bypassing
# AccessTrade entirely — useful while AccessTrade has Shopee publisher approvals paused. See
# lib/affiliate/shopee-direct.ts — the request-signing format there is reconstructed from
# Shopee's public docs and NOT yet verified against a live account; test against the API
# Explorer (open-api.affiliate.shopee.vn/explorer/v2) before enabling in production.
AFFILIATE_PROVIDER="mock"
ACCESSTRADE_API_KEY=""
ACCESSTRADE_API_BASE_URL="https://api.accesstrade.vn"
SHOPEE_AFFILIATE_APP_ID=""
SHOPEE_AFFILIATE_SECRET=""
SHOPEE_AFFILIATE_API_BASE_URL="https://open-api.affiliate.shopee.vn"

# --- Payout provider ---
# "mock" simulates bank payouts locally, no credentials needed.
# "vietqr" calls a real bank transfer API compatible with the VietQR-style contract — requires
# the keys below AND LEGAL_COMPLIANCE_CONFIRMED=true.
PAYOUT_PROVIDER="mock"
VIETQR_CLIENT_ID=""
VIETQR_API_KEY=""
VIETQR_API_BASE_URL="https://api.vietqr.io"

# --- Telegram bot ---
# Create a bot via @BotFather on Telegram (/newbot), then paste its token here. No token = the
# bot API calls in lib/telegram.ts will throw if invoked, but the rest of the app is unaffected.
TELEGRAM_BOT_TOKEN=""
# Bot's @username (without the @) — used to build the t.me deep link shown on /telegram.
TELEGRAM_BOT_USERNAME=""
# Optional shared secret Telegram echoes back in X-Telegram-Bot-Api-Secret-Token on every
# webhook call, set when registering the webhook — rejects spoofed requests if configured.
TELEGRAM_WEBHOOK_SECRET=""

# --- kie.ai (AI product video pipeline: model image + image-to-video) ---
# Get a key from https://kie.ai (API Key Management page). Required for /admin/products
# video generation — no mock fallback, since the point of this module is real AI output.
KIE_API_KEY=""
KIE_API_BASE_URL="https://api.kie.ai"
# Publicly reachable base URL of THIS app, used to build the callBackUrl kie.ai calls when a
# video clip finishes (e.g. https://kback-app.vercel.app, or an ngrok/tunnel URL for local dev).
# NOTE: the clip webhook lands wherever this URL points — if it's a deployed domain, the final
# ffmpeg render step does NOT run there (Vercel serverless can't run ffmpeg reliably). Instead,
# run `npm run assemble-worker` on a machine with ffmpeg — it polls the same DATABASE_URL for
# videos whose clips are all done and renders them there. See scripts/assemble-worker.ts.
APP_PUBLIC_URL=""
# From kie.ai dashboard -> Webhook HMAC Key. Used to verify inbound POST /api/webhooks/kie-video
# calls actually came from kie.ai. Leave empty during local dev if you're polling instead of
# receiving webhooks (e.g. no public tunnel set up yet).
KIE_WEBHOOK_HMAC_KEY=""

# --- File storage (product images, generated videos/audio) ---
# "local_disk" (default) writes to public/uploads and public/generated — fine for local dev, but
# does NOT work on serverless hosts (Vercel's function filesystem is read-only outside /tmp at
# runtime). "vercel_blob" is required in production — set STORAGE_PROVIDER=vercel_blob and
# connect a Blob store to the project (Vercel dashboard -> Storage -> Connect Project), which
# adds BLOB_READ_WRITE_TOKEN automatically. Swap to "minio" later once a MinIO endpoint is
# available (lib/storage/index.ts is the only place that needs to change).
STORAGE_PROVIDER="local_disk"
